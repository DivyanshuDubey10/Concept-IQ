# ============================================================
# ConceptIQ Backend — Environment Variables
# Copy this file to backend/.env and fill in all values.
# NEVER commit backend/.env to git.
# ============================================================

# ------------------------------------------------------------
# Database (Supabase PostgreSQL)
# Go to Supabase → Project Settings → Database → Connection string
# Use the "URI" (direct connection, port 5432) for production.
# Local dev: use the docker-compose PostgreSQL below.
# ------------------------------------------------------------

# Local dev:
# DATABASE_URL=postgresql://conceptiq:conceptiq_password@localhost:5432/conceptiq_db

# Supabase (production) — copy from Supabase dashboard:
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------
# JWT Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
SECRET_KEY=changeme-use-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------
# AI (NVIDIA NIM — used by teammate's intelligence layer)
# Get key from: https://integrate.api.nvidia.com
# ------------------------------------------------------------
NVIDIA_API_KEY=your-nvidia-api-key-here

# ------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# Local dev:   http://localhost:5173
# Production:  https://your-app.vercel.app
# ------------------------------------------------------------
FRONTEND_URLS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app
